# Public site URL (used for OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:43147

# SPEI / bank transfer placeholder (Mexico). Leave empty until you have an account.
NEXT_PUBLIC_SINPE_PHONE=

# EVM / Base USDC receive address. Leave empty until you have a wallet.
NEXT_PUBLIC_USDC_BASE_ADDRESS=

# Stellar USDC receive address. Leave empty until you have a wallet.
NEXT_PUBLIC_USDC_STELLAR_ADDRESS=

# Optional Solana USDC address.
NEXT_PUBLIC_USDC_SOLANA_ADDRESS=

# Password for /admin.
ADMIN_PASSWORD=IAC2026admin

# Neon Postgres — required on Vercel so reservations reach /admin.
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# stub (default) accepts a valid-looking tx hash after reservation.
# SPEI is always confirmed by hand in /admin.
PAYMENT_VERIFY_MODE=stub
